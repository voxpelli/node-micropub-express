{
  "name": "micropub-express",
  "version": "0.9.1",
  "license": "MIT",
  "description": "Provides a Micropub route for Express 4.x",
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "homepage": "https://github.com/voxpelli/node-micropub-express",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/node-micropub-express.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./core": "./lib/core.js"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build": "run-s build:*",
    "check:installed-check": "installed-check -i eslint",
    "check:knip": "knip",
    "check:lint": "eslint --report-unused-disable-directives .",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 90 --ignore-files 'test/**/*'",
    "check": "run-s clean && run-p check:*",
    "clean:declarations": "rm -rf $(find . -maxdepth 2 -type f -name '*.d.ts' -not -path './node_modules/*')",
    "clean": "run-p clean:*",
    "prepublishOnly": "run-s build",
    "test:node": "c8 node --test 'test/**/*.spec.js'",
    "test-ci": "run-s test:*",
    "test": "run-s clean check test:*"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^6.1.0",
    "nock": "^14.0.11",
    "npm-run-all2": "^8.0.4",
    "supertest": "^7.2.2",
    "type-coverage": "^2.29.7",
    "type-fest": "^4.41.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "bunyan-adaptor": "^7.0.0",
    "express": "^4.22.1",
    "multer": "1.4.4-lts.1",
    "pony-cause": "^2.1.11"
  }
}
